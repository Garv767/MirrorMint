# Database Configuration
NEON_DATABASE_URI=your_postgresql_connection_string_here

# Security & JWT
SECRET_KEY=generate_a_random_secure_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Admin Seeding
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=secure_password_here

# CORS & Frontend Integration
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.netlify.app
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app/api/v1
